From: Rust Browser maintainers
Subject: [PATCH] mse: wait for all initial buffers before publishing streams

The early incomplete-init branch leaked media_source_lock. Returning to the
caller also published no-more-pads with only the first buffer's tracks, so
playbin could permanently select video without the later audio track.

Return readiness to the caller, release the lock on every path and wait for
all initial buffers before the first pad/collection publication. Release the
transfer-full buffer list reference after checking it. Public ABI is unchanged.

Applies to GStreamer 1.28.8 commit
1b2a95a1b72787cda146b46df9605b168e5b683b, gst-libs/gst/mse subtree.
Original source retains its LGPL-2.1-or-later notices.

--- a/gst/mse/gstmsesrc.c
+++ b/gst/mse/gstmsesrc.c
@@ -266,7 +266,7 @@
 static GstStateChangeReturn gst_mse_src_change_state (GstElement * element,
     GstStateChange transition);
 static gboolean gst_mse_src_send_event (GstElement * element, GstEvent * event);
-static void update_ready_state_for_init_segment (GstMseSrc * self);
+static gboolean update_ready_state_for_init_segment (GstMseSrc * self);
 static void update_ready_state (GstMseSrc * self);
 
 G_DEFINE_TYPE_WITH_CODE (GstMseSrc, gst_mse_src, GST_TYPE_ELEMENT,
@@ -1216,7 +1216,8 @@
   GstElement *element = GST_ELEMENT (self);
   GstObject *object = GST_OBJECT (self);
 
-  update_ready_state_for_init_segment (self);
+  if (!update_ready_state_for_init_segment (self))
+    return;
 
   STREAMS_LOCK (self);
 
@@ -1337,15 +1338,18 @@
   g_object_notify_by_pspec (G_OBJECT (self), properties[PROP_READY_STATE]);
 }
 
-static void
+static gboolean
 update_ready_state_for_init_segment (GstMseSrc * self)
 {
+  gboolean initialized = FALSE;
+
   MEDIA_SOURCE_LOCK (self);
 
   if (self->media_source == NULL) {
     goto done;
   }
   if (self->ready_state != GST_MSE_SRC_READY_STATE_HAVE_NOTHING) {
+    initialized = TRUE;
     goto done;
   }
   GstSourceBufferList *buffers = gst_media_source_get_source_buffers
@@ -1359,14 +1363,17 @@
     all_received_init_segment &= gst_source_buffer_has_init_segment (buf);
     gst_object_unref (buf);
   }
+  gst_object_unref (buffers);
   if (!all_received_init_segment) {
-    return;
-  }
+    goto done;
+  }
+  initialized = TRUE;
   set_ready_state (self, MAX (self->ready_state,
           GST_MSE_SRC_READY_STATE_HAVE_METADATA));
 
 done:
   MEDIA_SOURCE_UNLOCK (self);
+  return initialized;
 }
 
 static gboolean
